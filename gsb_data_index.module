<?php
use Drupal\Core\Entity\EntityInterface;
use GuzzleHttp\Exception\RequestException;
use Drupal\node\Entity\Node;

/**
 * Implements hook_entity_insert().
 */
function gsb_data_index_entity_insert(\Drupal\Core\Entity\EntityInterface $entity) {
  if ($entity->bundle() == 'resource') {
    // Insert the new record into the data warehouse.
    $attributes = array(
      'dataset_id' => $entity->id(),
      'dataset_name' => $entity->label(),
      'az_id' => $entity->get('field_az_id')->value,
      'roam_id' => $entity->get('field_roam_subscription_id')->value,
      'redivis_id' => $entity->get('field_redivis_id')->value,
      'darc_id' => $entity->get('field_darc_airtable_id')->value
    );
    $response = gsb_data_index_snaplogic_api_call('POST', 'rh-dataindex/updateDataset', $attributes);

    // Pull the full record from the data warehouse.
    $response = gsb_data_index_snaplogic_api_call('GET', 'rh-dataindex/getDatasets?dataset_index_id=' . $entity->id());
    $results = json_decode($response['body'], true);
    if (!empty($results)) {
      // Update the entity with the new values and save.
      gsb_data_index_update_resource($entity, $results[0]);
      $entity->save();
    }
  }
  return;
}
function gsb_data_index_entity_presave(EntityInterface $entity) {
  if ($entity->bundle() == 'resource' && !$entity->isNew()) {
    gsb_data_index_update_dw_records($entity);
  }
  return;
}

/**
 * Implement hook_cron().
 */
function gsb_data_index_cron() {
  $state = \Drupal::state();
  $last_run = $state->get('gsb_data_index_import_dw_last_run', 0);
  $now = \Drupal::time()->getCurrentTime();

  // Run only if 5 minutes have passed.
  if ($now - $last_run >= 300) {
    // Get last updated records
    \Drupal::logger('gsb_data_index')->notice('Update Data Warehouse Data ran at ' . date('c'));
    $response = gsb_data_index_snaplogic_api_call('GET', 'rh-dataindex/getDatasets?updated_date=' . date('Y-m-d', $last_run));

    // If we have records to update.
    if ($response['status'] == 200 && !empty($response['body'])) {
      $body = json_decode($response['body'], true);

      // Get the datasets that need updating.
      $datasets_to_update = array_reduce($body, function($result, $item) {
        $result[$item['dataset_id']] = $item;
        return $result;
      }, []);

      // Get an array of the IDs that need updating.
      $dataset_ids = array_keys($datasets_to_update);

      // Get all nodes that match those ids.
      $nodes = \Drupal::entityTypeManager()
        ->getStorage('node')
        ->loadMultiple($dataset_ids);

      // Update the node with the new values.
      foreach ($nodes as $index => $node) {
        // Make sure it's the correct type, just in case
        if ($node->bundle() === 'resource') {

          // Update the resource with the updated data
          gsb_data_index_update_resource($node, $datasets_to_update[$index]);

          // Save the updated node.
          $node->save();
        }
      }

      \Drupal::logger('gsb_data_index')->notice('Updated @count resource nodes. NIDs: {nids}', ['@count' => count($nodes), 'nids' => json_encode(array_keys($nodes))]);
    }

    // Update last run time.
    $state->set('gsb_data_index_import_dw_last_run', $now);
  }
}

function gsb_data_index_update_dw_records($entity) {

  $fields_to_watch = array(
    'title',
    'field_az_id',
    'field_roam_subscription_id',
    'field_redivis_id',
    'field_darc_airtable_id',
  );

  // Get list of changed fields.
  $changed_fields = gsb_data_index_get_changed_fields($entity);

  // If a changed field is in one that we want to watch then update the data warehouse.
  if (array_keys_exists($fields_to_watch, $changed_fields)) {
    $attributes = array(
      'dataset_id' => $entity->id(),
      'dataset_name' => $entity->label(),
      'az_id' => $entity->get('field_az_id')->value,
      'roam_id' => $entity->get('field_roam_subscription_id')->value,
      'redivis_id' => $entity->get('field_redivis_id')->value,
      'darc_id' => $entity->get('field_darc_airtable_id')->value
    );

    $response = gsb_data_index_snaplogic_api_call('POST', 'rh-dataindex/updateDataset', $attributes);
  }

  $integration_fields = array(
    'field_az_id',
    'field_roam_subscription_id',
    'field_redivis_id',
    'field_darc_airtable_id',
  );

  // If the changed field is one of the integration ids then pull the new data.
  if (array_keys_exists($integration_fields, $changed_fields)) {
    $response = gsb_data_index_snaplogic_api_call('GET', 'rh-dataindex/getDatasets?dataset_index_id=' . $entity->id());
    $results = json_decode($response['body'], true);
    if (!empty($results)) {
      $results = $results[0];
      gsb_data_index_update_resource($entity, $results);
    }
  }
}

function gsb_data_index_get_changed_fields($entity) {
  $changed_fields = array();
  if ($entity->isNew()) {
    $changed_fields['is_new'] = true;
    foreach($entity->getFields() as $field_name => $field) {
      $field_type = $field->getFieldDefinition()->getType();
      $new_value = '';
      switch ($field_type) {
        case 'entity_reference':
          if (!$entity->get($field_name)->isEmpty()) {
            $new_value = (!$entity->get($field_name)->isEmpty()) ? $entity->get($field_name)->entity->label() : '';
          }
          break;

        case 'boolean':
          $new_value = filter_var($entity->get($field_name)->value, FILTER_VALIDATE_BOOLEAN);
          break;

        default:
          $new_value = $entity->get($field_name)->value;
      }

      $changed_fields[$field_name] = [
        'original' => NULL,
        'new' => $new_value,
        'field_type' => $field_type,
      ];
    }
  }
  else {
    $changed_fields['is_new'] = false;

    $original = $entity->original;

    foreach($entity->getFields() as $field_name => $field) {
      $field_type = $field->getFieldDefinition()->getType();
      $original_value = '';
      $new_value = '';
      switch($field_type) {
        case 'entity_reference':

          if (!$original->get($field_name)->isEmpty()) {
            $original_value = (!$original->get($field_name)->isEmpty()) ? $original->get($field_name)->entity->label() : '';
            $new_value = (!$entity->get($field_name)->isEmpty()) ? $entity->get($field_name)->entity->label() : '';
          }
          break;

        case 'boolean':
          $original_value = filter_var($original->get($field_name)->value, FILTER_VALIDATE_BOOLEAN);
          $new_value = filter_var($entity->get($field_name)->value, FILTER_VALIDATE_BOOLEAN);
          break;

        default:
          $original_value = $original->get($field_name)->value;
          $new_value = $entity->get($field_name)->value;
      }

      if ($original_value !== $new_value) {
        $changed_fields[$field_name] = array(
          'original' => $original_value,
          'new' => $new_value,
          'field_type' => $field_type,
        );
      }
    }
  }

  return $changed_fields;
}

function array_keys_exists(array $keys, array $array) {
  $diff = array_diff_key(array_flip($keys), $array);
  return count($diff) !== count($keys);
}
/**
 * Makes a REST POST request to SnapLogic API.
 */
function gsb_data_index_snaplogic_api_call($method, $endpoint, $data = null) {
  // Get the SnapLogic settings from config.
  $config = \Drupal::config('gsb_data_index.settings');
  $environment = $config->get('snaplogic_environment');
  $api_token = $config->get('snaplogic_api_token');

  // Ensure the API token is available.
  if (!$api_token) {
    \Drupal::logger('gsb_data_index')->error('SnapLogic API token is missing.');
    return;
  }

  // Define the endpoint URL.
  $url = 'https://elastic.snaplogic.com/api/1/rest/slsched/feed/' . $environment . '/GSB/' . $endpoint;

  // Define the headers.
  $headers = [
    'Authorization' => 'Bearer ' . $api_token,
    'Content-Type' => 'application/json',
  ];

  try {
    switch($method) {
      case 'POST':
        // Convert data array to JSON.
        $body = json_encode($data);

        // Make the POST request.
        $response = \Drupal::httpClient()->post($url, [
          'headers' => $headers,
          'body' => $body,
        ]);
        break;

      case 'GET':
        $response = \Drupal::httpClient()->get($url, [
          'headers' => $headers,
        ]);
        break;
    }

    // Get response status and body.
    $status_code = $response->getStatusCode();
    $response_body = $response->getBody()->getContents();

    // Log the response.
    \Drupal::logger('gsb_data_index')->notice('SnapLogic API Response: {api_response}', ['api_response' => json_encode($response_body)]);

    return [
      'status' => $status_code,
      'body' => $response_body,
    ];
  } catch (RequestException $e) {
    // Log errors.
    \Drupal::logger('gsb_data_index')->error('SnapLogic API Error: ' . $e->getMessage());
    return NULL;
  }
}

function gsb_data_index_update_resource(EntityInterface &$entity, $data) {
  // A2Z Data
  $entity->set('field_a_z_description', [
      'value' => $data['a2z_abstract'],
      'format' => 'full_html',
  ]);
  $entity->set('field_a_z_internal_note', [
      'value' => $data['a2z_internal_note'],
      'format' => 'full_html',
  ]);
  $entity->set('field_a_z_list_url', $data['a2z_url']);
  $entity->set('field_a_z_internal_note', $data['a2z_internal_note']);
  $az_visibility = ($data['a2z_visibility']) ? 'yes' : 'no';
  $entity->set('field_visible_in_a_z', $az_visibility);

  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $term_ids = [];

  if (!is_null($data['a2z_topics'])) {
    foreach (explode('|', $data['a2z_topics']) as $topic) {
      $terms = $term_storage->loadByProperties([
        'name' => $topic,
        'vid' => 'topics',
      ]);

      if (!empty($terms)) {
        $term = reset($terms);
        $term_ids[] = $term->id();
      }
    }

    $entity->set('field_topics', $term_ids);
  }

  // Redivis Data
  $entity->set('field_redivis_current_version', $data['redivis_current_version']);
  $entity->set('field_redivis_methodology', [
      'value' => $data['redivis_methodology'],
      'format' => 'full_html',
  ]);
  $entity->set('field_redivis_pub_access_level', $data['redivis_public_access_level']);
  $entity->set('field_redivis_released_date', (!is_null($data['redivis_release_date']) ? explode('.', $data['redivis_release_date'])[0] : ''));
  $entity->set('field_redivis_updated_date', (!is_null($data['redivis_version_updated_date']) ? explode('.', $data['redivis_version_updated_date'])[0] : ''));
  $entity->set('field_redivis_usage', [
      'value' => $data['redivis_usage_markdown'],
      'format' => 'full_html',
  ]);
  $entity->set('field_redivis_url', $data['redivis_url']);


  $bbox_value = '';
  if (!empty($data['redivis_geoBBox_west_longitude'])) {
    $bbox_top = $data['redivis_geoBBox_north_latitude'];
    $bbox_left = $data['redivis_geoBBox_west_longitude'];
    $bbox_bottom = $data['redivis_geoBBox_south_latitude'];
    $bbox_right = $data['redivis_geoBBox_east_longitude'];

    $bbox_value = 'POLYGON((' . $bbox_right . ' ' . $bbox_top . ', ' . $bbox_right . ' ' . $bbox_bottom . ', ' . $bbox_left . ' ' . $bbox_bottom . ', ' . $bbox_left . ' ' . $bbox_top . ', ' . $bbox_right . ' ' . $bbox_top . '))';
  }
  $entity->set('field_bbox', $bbox_value);

  // Roam Data
  $entity->set('field_roam_publisher_identifier', $data['roam_publisher_id']);
  $entity->set('field_publisher', $data['roam_publisher_names']);
  $entity->set('field_roam_license_id', $data['roam_license_id']);
  $entity->set('field_license_name', $data['roam_license_name']);
  $entity->set('field_normalized_price', $data['roam_subscription_period_normalized_price']);
  $entity->set('field_purchase_order_reference', $data['roam_subscription_period_member_purchase_order_reference']);

  $subscription_start_date = (!is_null($data['roam_subscription_period_subscription_start_date'])) ? explode('T', $data['roam_subscription_period_subscription_start_date'])[0] : '';;
  $subscription_end_date = (!is_null($data['roam_subscription_period_subscription_end_date'])) ? explode('T', $data['roam_subscription_period_subscription_end_date'])[0] : '';;
  $entity->set('field_subscription_period', [
    [
      'value' => $subscription_start_date,
      'end_value' =>  $subscription_end_date
    ]
  ]);

  $entity->set('field_vendor', $data['roam_vendor_name']);
  $entity->set('field_vendor_contact_email', $data['roam_vendor_email']);

  // DARC Data
  $entity->set('field_darc_notes', [
      'value' => $data['darc_data_description'],
      'format' => 'full_html',
  ]);
}
